#include "resource.h"
#include "app-info.h"
#include <windows.h>
#include <commctrl.h>
#pragma code_page(65001)
IDI_CHUCAO ICON "assets/branding/chucao.ico"
IDB_CHUCAO_HOME BITMAP "assets/branding/chucao-home.bmp"
IDB_CHUCAO_LOGO RCDATA "assets/branding/chucao-icon-256.png"

// Embed the application manifest. Without it Windows falls back to Common
// Controls v5, which does not register the SysLink class used by the About and
// Options dialogs, so DialogBoxParam fails and the buttons appear to do nothing.
// Keeping it in the executable also makes the portable folder and installer
// independent from an external Chucao.exe.manifest file.
1 24 "src/chucao.manifest"

IDD_ABOUT DIALOGEX 0, 0, 480, 320
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Acerca de Chucao"
FONT 9, "Segoe UI"
BEGIN
    // The icon is resized in AboutProc to match the height of the text block.
    ICON IDI_CHUCAO, IDC_ABOUT_ICON, 12, 12, 100, 100
    LTEXT "Chucao PDF Reader", IDC_ABOUT_TITLE, 150, 12, 316, 14
    LTEXT "", IDC_ABOUT_VERSION, 150, 30, 316, 12
    LTEXT "", IDC_ABOUT_AUTHOR, 150, 48, 316, 12
    LTEXT "", IDC_ABOUT_EMAIL, 150, 62, 316, 12
    LTEXT "", IDC_ABOUT_RELEASE, 150, 80, 316, 12
    CONTROL "<a href=""https://github.com/jabrugger/chucao-pdf-reader"">github.com/jabrugger/chucao-pdf-reader</a>", IDC_ABOUT_REPOSITORY, "SysLink", WS_TABSTOP, 150, 99, 316, 18
    LTEXT "Atajos de teclado", IDC_ABOUT_HOTKEYS_LABEL, 12, 132, 200, 12
    CONTROL "", IDC_ABOUT_HOTKEYS, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP | WS_VSCROLL, 12, 148, 456, 160
END

IDD_SETTINGS DIALOGEX 0, 0, 332, 336
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Opciones de Chucao"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Tema preferido", -1, 16, 16, 120, 12
    CONTROL "Sistema", IDC_SETTINGS_THEME_SYSTEM, "Button", BS_OWNERDRAW | WS_TABSTOP, 144, 10, 54, 22
    CONTROL "Claro", IDC_SETTINGS_THEME_LIGHT, "Button", BS_OWNERDRAW | WS_TABSTOP, 202, 10, 54, 22
    CONTROL "Oscuro", IDC_SETTINGS_THEME_DARK, "Button", BS_OWNERDRAW | WS_TABSTOP, 260, 10, 54, 22
    CONTROL "Reabrir los PDF de la última sesión", IDC_SETTINGS_RESTORE, "Button", BS_OWNERDRAW | WS_TABSTOP, 16, 48, 300, 16
    LTEXT "Al iniciar sin elegir un archivo. Los PDF protegidos volverán a pedir contraseña.", -1, 40, 68, 268, 26
    CONTROL "Mostrar automáticamente el índice", IDC_SETTINGS_OUTLINE, "Button", BS_OWNERDRAW | WS_TABSTOP, 16, 102, 300, 16
    LTEXT "Al abrir un PDF con marcadores. Si se desmarca, el índice aparece al acercar el puntero al borde izquierdo o con Ctrl+B.", -1, 40, 122, 268, 26
    CONTROL "Abrir los PDF con Chucao", IDC_SETTINGS_ASSOCIATE, "Button", BS_OWNERDRAW | WS_TABSTOP, 16, 156, 300, 16
    LTEXT "Registra a Chucao para abrir archivos PDF. Windows puede pedir confirmación; si no se aplica, usá el enlace de abajo.", -1, 40, 176, 268, 26
    CONTROL "Buscar actualizaciones al abrir", IDC_SETTINGS_UPDATES, "Button", BS_OWNERDRAW | WS_TABSTOP, 16, 210, 300, 16
    LTEXT "Consulta en GitHub si hay una versión nueva y avisa. Sin descarga automática ni telemetría.", -1, 40, 230, 268, 26
    CONTROL "Abrir Configuración de aplicaciones predeterminadas", IDC_SETTINGS_DEFAULTAPPS, "Button", BS_OWNERDRAW | WS_TABSTOP, 16, 264, 300, 18
    CONTROL "Olvidar recientes y posiciones guardadas", IDC_SETTINGS_CLEAR, "Button", BS_OWNERDRAW | WS_TABSTOP, 16, 288, 300, 18
    LTEXT "", IDC_SETTINGS_STATUS, 16, 310, 300, 20
END

1 VERSIONINFO
FILEVERSION CHUCAO_VERSION_NUMBERS
PRODUCTVERSION CHUCAO_VERSION_NUMBERS
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Chucao PDF Reader"
            VALUE "FileVersion", CHUCAO_VERSION_STRING
            VALUE "ProductName", "Chucao PDF Reader"
            VALUE "ProductVersion", CHUCAO_VERSION_STRING
            VALUE "CompanyName", CHUCAO_AUTHOR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
